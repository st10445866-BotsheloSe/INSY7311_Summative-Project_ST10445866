<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VedaApplication"
        tools:targetApi="31">

        <!-- 1. The Landing Page (MainActivity) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. The Authentication Page (AuthActivity) -->
        <activity
            android:name=".AuthActivity"
            android:exported="false" />

        <!-- 3. The Home Dashboard (DashboardActivity) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- 4. The Mood Logger (MoodLoggingActivity) -->
        <activity
            android:name=".MoodLoggingActivity"
            android:exported="false" />

        <!-- 5. The Habits Tracker (HabitsActivity) -->
        <activity
            android:name=".HabitsActivity"
            android:exported="false" />

        <!-- 6. The Insights / Trends Page (InsightsActivity) -->
        <activity
            android:name=".InsightsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- 7. The Settings / Profile Page -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

    </application>

</manifest>