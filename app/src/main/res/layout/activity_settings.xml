<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombre_green"
    android:padding="24dp">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5. Settings / Profile"
        android:textColor="@color/off_white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSettingsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consistency &amp; Standards, User Control &amp; Freedom"
        android:textColor="@color/off_white"
        android:alpha="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle" />

    <!-- Profile Section -->
    <LinearLayout
        android:id="@+id/profileSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsSubtitle">

        <TextView
            android:id="@+id/tvProfileCircle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_shape_gray"
            android:gravity="center"
            android:text="AS"
            android:textColor="@color/off_white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="alex.smith@email.com"
            android:textColor="@color/off_white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Notification Toggle -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Notifications"
        android:textColor="@color/off_white"
        android:textSize="18sp"
        android:thumbTint="@color/off_white"
        app:trackTint="@color/sage_accent"
        app:layout_constraintTop_toBottomOf="@id/profileSection" />

    <View
        android:id="@+id/divider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#44FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/switchNotifications" />

    <!-- Privacy Settings -->
    <LinearLayout
        android:id="@+id/layoutPrivacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/divider1">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Privacy Settings"
            android:textColor="@color/off_white"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/off_white" />
    </LinearLayout>

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#44FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/layoutPrivacy" />

    <!-- Export Data -->
    <TextView
        android:id="@+id/tvExportData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Export Data"
        android:textColor="@color/sage_accent"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/divider2" />

    <View
        android:id="@+id/divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#44FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvExportData" />

    <!-- Logout -->
    <TextView
        android:id="@+id/tvLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Log Out"
        android:textColor="#E5989B"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/divider3" />

    <!-- Bottom Navigation - FIXED: Added elevation and padding removal -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/off_white"
        android:elevation="8dp"
        app:itemIconTint="@color/sombre_green"
        app:itemTextColor="@color/sombre_green"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>