<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombre_green"
    android:padding="24dp">

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tvInsightsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4. Insights / Trends"
        android:textColor="@color/off_white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Timeframe Toggles (Interactive) -->
    <LinearLayout
        android:id="@+id/llToggles"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@drawable/toggle_background"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvInsightsTitle">

        <Button
            android:id="@+id/btnDaily"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Daily"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="@color/off_white" />

        <Button
            android:id="@+id/btnWeekly"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Weekly"
            android:textAllCaps="false"
            android:background="@drawable/active_toggle_shape"
            android:textColor="@color/sombre_green" />

        <Button
            android:id="@+id/btnMonthly"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Monthly"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="@color/off_white" />
    </LinearLayout>

    <!-- Interactive Line Chart (Dynamic visualization) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chartCard"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#2D4438"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/llToggles">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/moodLineChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Stats Cards (Displaying SharedPrefs Data) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/chartCard">

        <!-- Best Day Stat -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#2D4438"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Day:"
                    android:textColor="@color/off_white" />
                <TextView
                    android:id="@+id/tvBestDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="18sp"
                    android:textColor="@color/sage_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Average Sleep Stat -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#2D4438"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average Sleep:"
                    android:textColor="@color/off_white" />
                <TextView
                    android:id="@+id/tvAvgSleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0h"
                    android:textSize="18sp"
                    android:textColor="@color/sage_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Unified Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sombre_green"
        app:itemIconTint="@color/sage_accent"
        app:itemTextColor="@color/off_white"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>