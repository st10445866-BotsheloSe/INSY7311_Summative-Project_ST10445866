<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombre_green">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:padding="24dp"
        app:tint="@color/off_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How are you feeling?"
        android:textColor="@color/off_white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp" />

    <!-- Card-based Emoji Selector -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMoodSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#3A5F53"
        app:cardCornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMoodValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textSize="48sp"
                android:textColor="@color/sage_accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/moodSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="7"
                android:layout_marginTop="16dp"
                android:progressTint="@color/sage_accent"
                android:thumbTint="@color/off_white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <EditText
        android:id="@+id/etMoodNotes"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="24dp"
        android:background="@drawable/rounded_edittext"
        android:gravity="top"
        android:hint="Optional notes..."
        android:padding="16dp"
        android:textColor="@color/off_white"
        android:textColorHint="#80FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cvMoodSelector" />

    <Button
        android:id="@+id/btnLogMood"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:text="Log Mood"
        android:textAllCaps="false"
        android:backgroundTint="@color/sage_accent"
        android:textColor="@color/sombre_green"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>