<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombre_green">

    <!-- Header for User Control: Principle 3 -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_revert"
        android:padding="16dp"
        app:tint="@color/off_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Principle 2: Match System & Real World (1-10 Scale) -->
    <TextView
        android:id="@+id/tvMoodValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7"
        android:textSize="48sp"
        android:textColor="@color/off_white"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/moodSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Principle 4: Direct Manipulation -->
    <SeekBar
        android:id="@+id/moodSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="7"
        android:progressTint="@color/sage_accent"
        android:thumbTint="@color/off_white"
        android:layout_margin="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvMoodValue"
        app:layout_constraintBottom_toTopOf="@id/btnLogMood"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Button: Principle 5 Consistency -->
    <Button
        android:id="@+id/btnLogMood"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Log Mood"
        android:backgroundTint="@color/sage_accent"
        android:textColor="@color/sombre_green"
        android:layout_margin="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>