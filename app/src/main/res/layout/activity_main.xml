<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombre_green"
    tools:context=".MainActivity">

    <!-- Title and Subtitle -->
    <LinearLayout
        android:id="@+id/headerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Veda: Student Well-\nbeing App"
            android:textColor="@color/off_white"
            android:textSize="32sp"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Match Between System &amp; Real World,\nAesthetic &amp; Minimalist Design"
            android:textColor="@color/off_white"
            android:alpha="0.7"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Logo Placeholder (Circle with Arc) -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/circle_background"
        app:layout_constraintBottom_toTopOf="@+id/footerGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerGroup">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_veda_arc"
            app:tint="@color/off_white" />
    </FrameLayout>

    <!-- Footer Area -->
    <LinearLayout
        android:id="@+id/footerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Navigate Your Well-being Journey."
            android:textColor="@color/off_white"
            android:textSize="18sp"
            android:layout_marginBottom="120dp"/>

        <Button
            android:id="@+id/btnGoToMood"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginHorizontal="32dp"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="@color/sage_accent"
            android:textColor="@color/sombre_green"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Already have an account? Log In"
            android:textColor="@color/off_white"
            android:alpha="0.8" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>